{
  "name": "flicker",
  "version": "1.0.0",
  "description": "Local media triage app — full-screen swipe-style delete/move/keep for photos and videos.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "dist:installer": "electron-builder --win nsis",
    "dist:store": "electron-builder --win appx"
  },
  "author": "nynglng",
  "license": "ISC",
  "devDependencies": {
    "electron": "^32.3.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.flicker.app",
    "productName": "Flicker",
    "files": [
      "flicker.html",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "win": {
      "target": ["portable", "nsis"],
      "icon": "build/flicker.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Flicker-Setup-${version}.${ext}"
    },
    "appx": {
      "applicationId": "Flicker",
      "identityName": "nynglng.FlickerMediaTriage",
      "publisher": "CN=2E5C8D9E-7195-4A8E-BE16-2BE288124A05",
      "publisherDisplayName": "nynglng",
      "displayName": "Flicker Media Triage",
      "backgroundColor": "#0B0C0F",
      "showNameOnTiles": true
    },
    "copyright": "Copyright © 2026 nynglng",
    "mac": {
      "icon": "build/flicker.icns"
    },
    "linux": {
      "icon": "build/icon.png"
    },
    "directories": {
      "output": "dist"
    }
  },
  "allowScripts": {
    "electron@32.3.3": true
  }
}
